{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    // Lets ts-jest compile each test file on its own instead of type-checking against all of
    // aws-cdk-lib (~900 MB per Jest worker, which ran CI out of memory). `npm run build` still
    // type-checks everything, and CI runs it before the tests.
    "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "include": ["bin", "lib", "lambda", "test"],
  "exclude": ["node_modules", "cdk.out"]
}
